{
  "$schema": "http://json.schemastore.org/sarif-2.1.0",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "version": "1.10.3",
          "informationUri": "https://github.com/doyensec/electronegativity",
          "name": "Electronegativity",
          "fullName": "Electronegativity is a tool to identify misconfigurations and security anti-patterns in Electron applications",
          "rules": [
            {
              "id": "CSP_GLOBAL_CHECK",
              "fullDescription": {
                "text": "One or more CSP directives detected seems to be vulnerable"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/CSP_GLOBAL_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/CSP_GLOBAL_CHECK"
              }
            },
            {
              "id": "AUXCLICK_JS_CHECK",
              "fullDescription": {
                "text": "Limit navigation flows to untrusted origins. Middle-click may cause Electron to open a link within a new window"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/AUXCLICK_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/AUXCLICK_JS_CHECK"
              }
            },
            {
              "id": "PRELOAD_JS_CHECK",
              "fullDescription": {
                "text": "Review the use of preload scripts"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/PRELOAD_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/PRELOAD_JS_CHECK"
              }
            },
            {
              "id": "OPEN_EXTERNAL_JS_CHECK",
              "fullDescription": {
                "text": "Review the use of openExternal"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/OPEN_EXTERNAL_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/OPEN_EXTERNAL_JS_CHECK"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CSP_GLOBAL_CHECK",
          "level": "note",
          "message": {
            "text": "One or more CSP directives detected seems to be vulnerable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "renderer\\index.html"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 1,
                  "charLength": 204
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUXCLICK_JS_CHECK",
          "level": "warning",
          "message": {
            "text": "Limit navigation flows to untrusted origins. Middle-click may cause Electron to open a link within a new window"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main\\index.ts"
                },
                "region": {
                  "startLine": 64,
                  "startColumn": 22,
                  "charLength": 38
                }
              }
            }
          ]
        },
        {
          "ruleId": "PRELOAD_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Review the use of preload scripts"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main\\index.ts"
                },
                "region": {
                  "startLine": 71,
                  "startColumn": 7,
                  "charLength": 48
                }
              }
            }
          ]
        },
        {
          "ruleId": "OPEN_EXTERNAL_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Review the use of openExternal"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main\\index.ts"
                },
                "region": {
                  "startLine": 122,
                  "startColumn": 46,
                  "charLength": 72
                }
              }
            }
          ]
        }
      ],
      "invocations": [
        {
          "workingDirectory": {
            "uri": "file:///C:\\Users\\Joshua\\Desktop\\Desktop App prototype\\studyplan\\src"
          },
          "executionSuccessful": true
        }
      ]
    }
  ]
}
