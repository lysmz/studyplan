# The spike is completely dormant unless this flag is set to true.
POWERSYNC_SPIKE_ENABLED=false

# Give two running app instances different IDs to create separate local replicas.
POWERSYNC_SPIKE_DEVICE_ID=device-a

# PowerSync Cloud or self-hosted service URL.
POWERSYNC_SPIKE_ENDPOINT=https://your-instance.powersync.journeyapps.com

# Disposable Supabase project used as source database and identity provider.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
POWERSYNC_SPIKE_EMAIL=alice@example.test
POWERSYNC_SPIKE_PASSWORD=replace-me

# Second-spike cloud harness. Passwords remain local and must never be committed.
POWERSYNC_SPIKE_ALICE_EMAIL=alice@example.com
POWERSYNC_SPIKE_ALICE_PASSWORD=replace-me
POWERSYNC_SPIKE_BOB_EMAIL=bob@example.com
POWERSYNC_SPIKE_BOB_PASSWORD=replace-me
