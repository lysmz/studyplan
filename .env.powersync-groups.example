# Copy this file to .env.powersync-groups.local. The local file is ignored by Git.
POWERSYNC_SPIKE_ENDPOINT=https://your-instance.powersync.journeyapps.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
POWERSYNC_SPIKE_ALICE_EMAIL=alice@example.com
POWERSYNC_SPIKE_ALICE_PASSWORD=replace-me
POWERSYNC_SPIKE_BOB_EMAIL=bob@example.com
POWERSYNC_SPIKE_BOB_PASSWORD=replace-me
